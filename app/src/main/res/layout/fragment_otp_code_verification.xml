<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true"
    android:layoutDirection="ltr"
    tools:context=".view.fragment.OtpCodeVerificationFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/coordinatorLayout"
            android:layout_width="0dp"
            android:layout_height="@dimen/toolbar_height"
            android:background="@color/toolbar_color"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <dev.aban.visible.utils.custom_view.TextViewPlus
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/otp_code"
                android:textColor="@color/toolbar_content_color"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/fragment_otp_code_verification_back"
                android:layout_width="55dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical|right"
                android:padding="17dp"
                android:scaleX="-1"
                android:src="@drawable/ic_back_black" />

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <dev.aban.visible.utils.custom_view.EditTextPlus
            android:id="@+id/fragment_otp_code_verification_et"
            android:layout_width="0dp"
            android:layout_height="@dimen/normal_button_height"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:background="@color/light_gray"
            android:gravity="center"
            android:hint="@string/otp_code"
            android:inputType="number"
            android:maxLength="4"
            android:maxLines="1"
            android:paddingLeft="@dimen/normal_button_padding"
            android:paddingRight="@dimen/normal_button_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/coordinatorLayout" />

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/fragment_otp_code_verification_enter_container"
            android:layout_width="0dp"
            android:layout_height="@dimen/normal_button_height"
            android:layout_marginLeft="36dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="36dp"
            android:background="@drawable/register_accent_round_color"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"

            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_otp_code_verification_et"
            app:layout_constraintVertical_bias="0.582"
            app:layout_goneMarginTop="12dp">


            <dev.aban.visible.utils.custom_view.TextViewPlus
                android:id="@+id/fragment_otp_code_verification_enter_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:clickable="false"
                android:gravity="center"
                android:text="@string/register"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:visibility="visible" />

            <ProgressBar
                android:id="@+id/fragment_otp_code_verification_enter_pb"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminateTint="@android:color/white"
                android:visibility="gone" />

        </androidx.coordinatorlayout.widget.CoordinatorLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>