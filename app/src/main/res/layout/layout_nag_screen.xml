<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="290dp"
    android:background="@drawable/round_white_corner"
    android:minHeight="270dp"
    android:paddingTop="12dp">

    <dev.aban.visible.utils.custom_view.TextViewPlus
        android:id="@+id/nag_top_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notification !"
        android:textColor="@android:color/holo_red_light"
        android:textSize="18sp"
        app:bold="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/nag_image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nag_top_title" />

    <dev.aban.visible.utils.custom_view.TextViewPlus
        android:id="@+id/nag_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:maxLines="1"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@id/nag_image" />

    <dev.aban.visible.utils.custom_view.TextViewPlus
        android:id="@+id/nag_description"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:lineSpacingExtra="5dp"
        android:maxLines="5"
        android:textColor="#3C3C3C"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/nag_options_container"
        app:layout_constraintLeft_toLeftOf="@id/nag_title"
        app:layout_constraintRight_toLeftOf="@+id/nag_image"
        app:layout_constraintTop_toBottomOf="@id/nag_title" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nag_options_container"
        android:layout_width="0dp"
        android:layout_height="54dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">


        <dev.aban.visible.utils.custom_view.TextViewPlus
            android:id="@+id/nag_show_em"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@android:color/holo_green_light"
            android:gravity="center"
            android:text="Yes, Download it!"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/nag_no"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <dev.aban.visible.utils.custom_view.TextViewPlus
            android:id="@+id/nag_no"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="#D2FF0000"
            android:gravity="center"
            android:text="No, thanks"
            android:textColor="@android:color/white"
            android:textSize="16sp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/nag_show_em"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>