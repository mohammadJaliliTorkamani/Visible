<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_main_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:layoutDirection="ltr"
    tools:context=".view.fragment.MainPageFragment">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/light_gray"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/fragment_main_top_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:layout_gravity="top"
            android:background="@color/toolbar_color"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/fragment_main_camera_change"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginRight="12dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_change"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">


                    <dev.aban.visible.utils.custom_view.TextViewPlus
                        android:id="@+id/fragment_main_header_name"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@string/app_name_separated"
                        android:textColor="@color/toolbar_content_color"
                        android:textSize="14sp"
                        android:visibility="visible"
                        app:bold="true"

                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/fragment_main_shine_imageview"
                        android:layout_width="50dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="-50dp"
                        android:src="@drawable/glare_effect" />
                </RelativeLayout>

                <ImageView
                    android:id="@+id/fragment_main_toolbar_expand_iv"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:scaleX="-1"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_menu_bar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.appcompat.widget.Toolbar>

        <FrameLayout
            class="dev.aban.visible.view.fragment.BlankFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_anchorGravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_main_top_toolbar"
            tools:layout="@layout/fragment_blank">


            <fragment
                android:id="@+id/camera_view"
                class="dev.aban.visible.view.fragment.BlankFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:layout="@layout/fragment_blank" />

            <dev.aban.visible.utils.custom_view.TextViewPlus
                android:id="@+id/fragment_main_no_filter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/light_gray"
                android:gravity="center"
                android:text="No bubbles has selected\n\nSelect bubble" />

            <ImageView
                android:id="@+id/fragment_main_filter"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="bottom|right"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="30dp"
                android:padding="12dp"
                android:src="@drawable/ic_photos" />

            <ImageView
                android:id="@+id/fragment_main_capture"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="20dp"
                android:padding="12dp"
                android:src="@drawable/ic_frame"
                android:visibility="gone" />


        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        layout="@layout/navigation_drawer"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>