<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true"
    android:layoutDirection="ltr"
    tools:context=".view.fragment.RegisterFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fragment_register_image_container"
            android:layout_width="0dp"
            android:layout_height="200dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/fragment_register_image"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:src="@android:color/white"
                app:civ_border_color="@color/picture_chooser_border"
                app:civ_border_width="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <dev.aban.visible.utils.custom_view.TextViewPlus
                android:id="@+id/fragment_register_image_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/image_upload"
                android:textColor="@android:color/black"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginTop="90dp"
                android:layout_marginRight="90dp"
                android:rotation="-30"
                android:src="@drawable/ic_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <dev.aban.visible.utils.custom_view.EditTextPlus
            android:id="@+id/fragment_register_full_name"
            android:layout_width="0dp"
            android:layout_height="@dimen/normal_button_height"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="24dp"
            android:background="@color/light_gray"
            android:gravity="right|center_vertical"
            android:hint="@string/name"
            android:maxLength="30"
            android:maxLines="1"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@android:color/black"
            android:textColorHint="@color/complete_profile_hint_color"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_register_image_container" />

        <dev.aban.visible.utils.custom_view.EditTextPlus
            android:id="@+id/fragment_register_phone"
            android:layout_width="0dp"
            android:layout_height="@dimen/normal_button_height"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="24dp"
            android:background="@color/light_gray"
            android:gravity="right|center_vertical"
            android:hint="@string/phone"
            android:inputType="phone"
            android:maxLength="11"
            android:maxLines="1"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@android:color/black"
            android:textColorHint="@color/complete_profile_hint_color"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_register_full_name" />

        <dev.aban.visible.utils.custom_view.EditTextPlus
            android:id="@+id/fragment_register_username"
            android:layout_width="0dp"
            android:layout_height="@dimen/normal_button_height"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="24dp"
            android:background="@color/light_gray"
            android:gravity="right|center_vertical"
            android:hint="@string/username"
            android:maxLength="40"
            android:maxLines="1"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@android:color/black"
            android:textColorHint="@color/complete_profile_hint_color"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_register_phone" />

        <dev.aban.visible.utils.custom_view.EditTextPlus
            android:id="@+id/fragment_register_password"
            android:layout_width="0dp"
            android:layout_height="@dimen/normal_button_height"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="24dp"
            android:background="@color/light_gray"
            android:gravity="right|center_vertical"
            android:hint="@string/password_min_8_digit"
            android:inputType="textPassword"
            android:maxLength="40"
            android:maxLines="1"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@android:color/black"
            android:textColorHint="@color/complete_profile_hint_color"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_register_username" />


        <dev.aban.visible.utils.custom_view.TextViewPlus
            android:id="@+id/fragment_register_birthday"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="24dp"
            android:gravity="center_vertical|right"
            android:maxLength="30"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/birthday"
            android:textSize="13sp"
            app:bold="true"

            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_register_password" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fragment_register_birthday_info_container"
            android:layout_width="0dp"
            android:layout_height="@dimen/normal_button_height"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_register_birthday">

            <dev.aban.visible.utils.custom_view.EditTextPlus
                android:id="@+id/fragment_register_birthday_day"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:background="@color/light_gray"
                android:gravity="center"
                android:hint="@string/dayOfWeek"
                android:inputType="number"
                android:maxLength="2"
                android:maxLines="1"
                android:minWidth="90dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <dev.aban.visible.utils.custom_view.EditTextPlus
                android:id="@+id/fragment_register_birthday_month"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:background="@color/light_gray"
                android:gravity="center"
                android:hint="@string/month"
                android:inputType="number"
                android:maxLength="2"
                android:maxLines="1"
                android:minWidth="90dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/fragment_register_birthday_year"
                app:layout_constraintRight_toLeftOf="@id/fragment_register_birthday_day"
                app:layout_constraintTop_toTopOf="parent" />

            <dev.aban.visible.utils.custom_view.EditTextPlus
                android:id="@+id/fragment_register_birthday_year"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:background="@color/light_gray"
                android:gravity="center"
                android:hint="@string/year"
                android:inputType="number"
                android:maxLength="4"
                android:maxLines="1"
                android:minWidth="90dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="@android:color/black"
                android:textColorHint="@color/complete_profile_hint_color"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <dev.aban.visible.utils.custom_view.TextViewPlus
            android:id="@+id/fragment_register_gender"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="24dp"
            android:gravity="center_vertical|right"
            android:maxLength="30"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/gender"
            android:textSize="13sp"
            app:bold="true"

            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_register_birthday_info_container" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fragment_register_gender_container"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_register_gender">

            <androidx.cardview.widget.CardView
                android:id="@+id/fragment_register_gender_divider"
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:backgroundTint="@android:color/black"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/fragment_register_gender_female"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:src="@drawable/ic_female_unselected"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@id/fragment_register_gender_divider"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/fragment_register_gender_male"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:src="@drawable/ic_male_selected"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/fragment_register_gender_divider"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/fragment_register_confirm_container"
            android:layout_width="0dp"
            android:layout_height="@dimen/normal_button_height"
            android:layout_marginLeft="36dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="36dp"
            android:background="@drawable/register_accent_round_color"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_register_gender_container"
            app:layout_constraintVertical_bias="0.582">


            <dev.aban.visible.utils.custom_view.TextViewPlus
                android:id="@+id/fragment_register_confirm_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:clickable="false"
                android:gravity="center"
                android:text="@string/register"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:visibility="visible" />

            <ProgressBar
                android:id="@+id/fragment_register_confirm_pb"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminateTint="@android:color/white"
                android:visibility="gone" />

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <dev.aban.visible.utils.custom_view.TextViewPlus
            android:id="@+id/fragment_register_have_account_question"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/already_have_an_account"
            android:textColor="@android:color/black"
            android:textSize="13sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragment_register_confirm_container" />

        <dev.aban.visible.utils.custom_view.TextViewPlus
            android:id="@+id/fragment_register_login_account"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="syekan.otf"
            android:gravity="center"
            android:paddingLeft="4dp"
            android:paddingTop="2dp"
            android:paddingRight="4dp"
            android:text="@string/login_into_account"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            app:bold="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_register_have_account_question"
            app:underline="true" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
