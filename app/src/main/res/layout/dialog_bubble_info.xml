<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="500dp"
    android:background="@drawable/round_white_corner"
    android:layoutDirection="ltr">

    <ProgressBar
        android:id="@+id/dialog_bubble_info_pb"
        android:layout_width="45dp"
        android:layout_height="45dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_bubble_info_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <dev.aban.visible.utils.custom_view.TextViewPlus
            android:id="@+id/dialog_bubble_info_get"
            android:layout_width="100dp"
            android:layout_height="32dp"
            android:layout_marginLeft="24dp"
            android:background="@drawable/accent_round_color"
            android:gravity="center"
            android:text="دریافت"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:bold="true"
            app:layout_constraintBottom_toBottomOf="@id/dialog_bubble_info_logo"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@id/dialog_bubble_info_logo" />

        <info.abdolahi.CircularMusicProgressBar
            android:id="@+id/dialog_bubble_info_logo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="20dp"
            app:border_color="@color/light_gray"
            app:border_width="2dp"
            app:centercircle_diammterer="1"
            app:draw_anticlockwise="false"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:progress_color="@color/colorAccent"
            app:progress_startAngle="-90" />

        <dev.aban.visible.utils.custom_view.TextViewPlus
            android:id="@+id/dialog_bubble_info_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="24dp"
            android:maxLines="1"
            android:textColor="@android:color/black"
            android:textSize="15sp"

            app:layout_constraintBottom_toTopOf="@id/dialog_bubble_info_price"
            app:layout_constraintRight_toLeftOf="@id/dialog_bubble_info_logo"
            app:layout_constraintTop_toTopOf="@+id/dialog_bubble_info_logo" />

        <dev.aban.visible.utils.custom_view.TextViewPlus
            android:id="@+id/dialog_bubble_info_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="24dp"
            android:maxLines="1"
            android:textColor="@android:color/darker_gray"
            android:textSize="13sp"

            app:layout_constraintBottom_toBottomOf="@+id/dialog_bubble_info_logo"
            app:layout_constraintRight_toLeftOf="@id/dialog_bubble_info_logo"
            app:layout_constraintTop_toBottomOf="@id/dialog_bubble_info_title" />


        <dev.aban.visible.utils.custom_view.TextViewPlus
            android:id="@+id/dialog_bubble_info_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:minHeight="70dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:textColor="@android:color/darker_gray"
            android:textSize="16sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dialog_bubble_info_logo" />

        <dev.aban.visible.utils.custom_view.TextViewPlus
            android:id="@+id/dialog_bubble_info_screenshot_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginRight="24dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="تصاویر :"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            app:bold="true"

            app:layout_constraintRight_toRightOf="@id/dialog_bubble_info_description"
            app:layout_constraintTop_toBottomOf="@id/dialog_bubble_info_description" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dialog_bubble_info_rv"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:minHeight="180dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dialog_bubble_info_screenshot_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>