<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/filter_border_item"
    android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="2dp"
        android:orientation="vertical"
        android:weightSum="100"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/item_filter_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="82"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <dev.aban.visible.utils.custom_view.TextViewPlus
            android:id="@+id/item_filter_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_weight="18"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@android:color/black"
            app:bold="true"
            app:layout_constraintLeft_toLeftOf="@id/item_filter_image"
            app:layout_constraintRight_toRightOf="@+id/item_filter_image"
            app:layout_constraintTop_toBottomOf="@id/item_filter_image" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>