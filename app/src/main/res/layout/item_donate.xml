<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_marginBottom="16dp"
    android:layoutDirection="ltr"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <RadioButton
        android:id="@+id/item_donate_rb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/item_donate_image"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginLeft="24dp"
        android:src="@color/light_gray"
        app:civ_border_color="@color/borders_color"
        app:civ_border_width="0.3dp"
        app:layout_constraintBottom_toBottomOf="@+id/item_donate_rb"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_donate_rb" />

    <dev.aban.visible.utils.custom_view.TextViewPlus
        android:id="@+id/item_donate_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="24dp"
        android:maxLines="1"
        android:textColor="@android:color/black"
        android:textSize="13sp"

        app:layout_constraintBottom_toTopOf="@id/item_donate_price"
        app:layout_constraintRight_toLeftOf="@id/item_donate_image"
        app:layout_constraintTop_toTopOf="parent" />

    <dev.aban.visible.utils.custom_view.TextViewPlus
        android:id="@+id/item_donate_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@android:color/black"
        android:textSize="13sp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="@id/item_donate_title"
        app:layout_constraintTop_toBottomOf="@id/item_donate_title" />


</androidx.constraintlayout.widget.ConstraintLayout>